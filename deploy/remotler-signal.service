# systemd unit for the Remotler signaling/relay + web control plane.
# Install to /etc/systemd/system/remotler-signal.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now remotler-signal
#
# IMPORTANT: change ADMIN_PASSWORD and PLATFORM_PASSWORD before exposing this publicly.

[Unit]
Description=Remotler signaling/relay + web control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=remotler
WorkingDirectory=/opt/remotler/server
# Bind to localhost only — Caddy terminates TLS on 443 and proxies to this port.
Environment=PORT=8081
Environment=NODE_ENV=production
Environment=UPDATE_DIR=/opt/remotler/server/update
Environment=ADMIN_PASSWORD=change-me-admin
Environment=PLATFORM_PASSWORD=change-me-platform
# Server-wide ICE defaults handed to every org that hasn't set its own (panel →
# Configurations → Network / relay). Without a TURN fallback, peers that can't
# STUN-hole-punch (symmetric NAT, UDP-blocked networks) fail with "no network path".
# TURN_SECRET must match `static-auth-secret` in /etc/turnserver.conf (coturn
# use-auth-secret mode); the server then mints short-lived per-session credentials.
Environment=STUN_URLS=stun:remotler.com:3478
Environment=TURN_URL=turn:remotler.com:3478
Environment=TURN_SECRET=change-me-turn-secret
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=3

# Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target

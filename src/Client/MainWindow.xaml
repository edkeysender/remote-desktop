<Window x:Class="RemoteDesktop.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FTD Remote — Client (this PC)" Height="560" Width="420"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="#0d1117">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#e6edf3"/></Style>
        <Style TargetType="Label"><Setter Property="Foreground" Value="#8b949e"/><Setter Property="FontSize" Value="12"/></Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <Image Source="pack://application:,,,/logo-ftd.png" Height="34" HorizontalAlignment="Left"
                   Margin="0,0,0,12" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Allow this computer to be controlled" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Give the ID and password below to the person connecting." Foreground="#8b949e" FontSize="12" Margin="0,2,0,0"/>
            <Button x:Name="UpdateBtn" Content="⬇ Update available" HorizontalAlignment="Left"
                    Background="#9e6a03" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Padding="12,5" Margin="0,10,0,0" Visibility="Collapsed" Click="UpdateBtn_Click"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#161b22" CornerRadius="10" Padding="18" Margin="0,0,0,12">
            <StackPanel>
                <Label Content="YOUR ID"/>
                <TextBox x:Name="IdBox" Text="—" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         Foreground="#58a6ff" FontSize="30" FontWeight="Bold" FontFamily="Consolas" Padding="0"/>
                <Label Content="PASSWORD (edit to change — it stays fixed)" Margin="0,10,0,0"/>
                <TextBox x:Name="PwBox" FontSize="20" FontFamily="Consolas" Background="#0d1117"
                         Foreground="#e6edf3" BorderBrush="#30363d" Padding="6,4"
                         LostFocus="Settings_LostFocus"/>
            </StackPanel>
        </Border>

        <!-- Shown only when the unattended service has provisioned fixed credentials
             (read from %ProgramData%\FTD Remote\machine.json). -->
        <Border Grid.Row="2" x:Name="UnattendedPanel" Background="#161b22" CornerRadius="10"
                Padding="18,14" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="🔒 Unattended access (always on)" Foreground="#8b949e"
                           FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="ID"/>
                        <TextBox x:Name="UnIdBox" Text="—" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" Foreground="#58a6ff" FontSize="20"
                                 FontWeight="Bold" FontFamily="Consolas" Padding="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <Label Content="PASSWORD"/>
                        <TextBox x:Name="UnPwBox" Text="—" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" Foreground="#e6edf3" FontSize="20"
                                 FontFamily="Consolas" Padding="0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" x:Name="Banner" Background="#12261a" CornerRadius="8" Padding="12,8"
                Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock x:Name="BannerText" Text="● SESSION ACTIVE — someone is viewing this screen"
                       Foreground="#3fb950" FontWeight="SemiBold" FontSize="13"
                       TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="4">
            <Label Content="SIGNALING SERVER"/>
            <TextBox x:Name="ServerBox" Background="#0d1117" Foreground="#e6edf3" BorderBrush="#30363d"
                     Padding="6,4" LostFocus="Settings_LostFocus"/>
        </StackPanel>

        <TextBlock Grid.Row="5" x:Name="StatusText" Text="Starting…" Foreground="#8b949e"
                   VerticalAlignment="Bottom" TextWrapping="Wrap" Margin="0,12,0,10"/>

        <Border Grid.Row="6" Background="#161b22" CornerRadius="8" Padding="12,10">
            <TextBlock Foreground="#8b949e" FontSize="12" TextWrapping="Wrap"
                       Text="This computer is available for connection whenever this app is open. Close the window to stop sharing."/>
        </Border>
    </Grid>
</Window>

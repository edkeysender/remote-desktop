<Window x:Class="RemoteDesktop.Master.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FTD Remote" Height="640" Width="980"
        WindowStartupLocation="CenterScreen" Background="#010409">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#e6edf3"/></Style>
        <Style x:Key="Lbl" TargetType="TextBlock"><Setter Property="Foreground" Value="#8b949e"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,10,0,4"/></Style>
        <Style x:Key="Sec" TargetType="TextBlock"><Setter Property="Foreground" Value="#8b949e"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#010409"/><Setter Property="Foreground" Value="#e6edf3"/><Setter Property="BorderBrush" Value="#30363d"/><Setter Property="Padding" Value="6,5"/></Style>
        <Style TargetType="PasswordBox"><Setter Property="Background" Value="#010409"/><Setter Property="Foreground" Value="#e6edf3"/><Setter Property="BorderBrush" Value="#30363d"/><Setter Property="Padding" Value="6,5"/></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#0d1117"/><Setter Property="BorderBrush" Value="#30363d"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
        <Style x:Key="Btn" TargetType="Button"><Setter Property="Background" Value="#21262d"/><Setter Property="Foreground" Value="#e6edf3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="12,7"/></Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}"><Setter Property="Background" Value="#238636"/><Setter Property="Foreground" Value="White"/></Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,4,14">
            <Image Source="pack://application:,,,/logo-ftd.png" Height="26" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="FTD Remote" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <TextBlock x:Name="AccountBadge" Text="" Foreground="#58a6ff" VerticalAlignment="Center" Margin="14,0,0,0"/>
            <Button x:Name="UpdateBtn" Content="⬇ Update available" Style="{StaticResource Btn}"
                    Background="#9e6a03" Foreground="White" Margin="14,0,0,0"
                    Visibility="Collapsed" Click="UpdateBtn_Click"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: this computer + account -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Sec}" Text="THIS COMPUTER — available while the app is open"/>
                            <TextBlock Text="ID"  Style="{StaticResource Lbl}"/>
                            <TextBox x:Name="IdBox" Text="—" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     Foreground="#58a6ff" FontSize="28" FontWeight="Bold" FontFamily="Consolas" Padding="0"/>
                            <TextBlock Text="PASSWORD (edit to set a fixed connection password)" Style="{StaticResource Lbl}"/>
                            <TextBox x:Name="HostPwBox" FontSize="18" FontFamily="Consolas" LostFocus="HostSettings_LostFocus"/>
                            <TextBlock x:Name="HostStatus" Text="Starting…" Foreground="#8b949e" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Sec}" Text="ACCOUNT"/>
                            <!-- signed OUT -->
                            <StackPanel x:Name="SignedOutPanel">
                                <TextBlock Text="Signaling server" Style="{StaticResource Lbl}"/>
                                <TextBox x:Name="ServerBox" LostFocus="HostSettings_LostFocus"/>
                                <TextBlock Text="Email" Style="{StaticResource Lbl}"/>
                                <TextBox x:Name="EmailBox"/>
                                <TextBlock Text="Password" Style="{StaticResource Lbl}"/>
                                <PasswordBox x:Name="LoginPwBox"/>
                                <Button x:Name="SignInBtn" Style="{StaticResource Primary}" Content="Sign in"
                                        Margin="0,14,0,0" Click="SignInBtn_Click"/>
                                <TextBlock x:Name="AccountMsg" Foreground="#f85149" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#8b949e" FontSize="12">
                                    <Run Text="No account?"/> <Hyperlink x:Name="RegisterLink" Click="RegisterLink_Click" Foreground="#58a6ff">Create one in your browser</Hyperlink><Run Text=", then sign in here."/>
                                </TextBlock>
                            </StackPanel>
                            <!-- signed IN -->
                            <StackPanel x:Name="SignedInPanel" Visibility="Collapsed">
                                <TextBlock x:Name="SignedInText" TextWrapping="Wrap"/>
                                <Button x:Name="SignOutBtn" Style="{StaticResource Btn}" Content="Sign out"
                                        HorizontalAlignment="Left" Margin="0,12,0,0" Click="SignOutBtn_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT: connect -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Sec}" Text="CONNECT TO A COMPUTER"/>

                    <!-- manual connect -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ConnIdBox" Grid.Column="0" FontFamily="Consolas" VerticalContentAlignment="Center"
                                 ToolTip="Enter an ID"/>
                        <TextBox x:Name="ConnPwBox" Grid.Column="1" Width="110" Margin="6,0,0,0" FontFamily="Consolas"
                                 VerticalContentAlignment="Center" ToolTip="Password"/>
                        <Button x:Name="ManualConnectBtn" Grid.Column="2" Style="{StaticResource Primary}" Content="Connect"
                                Margin="6,0,0,0" Click="ManualConnectBtn_Click"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,6">
                        <TextBlock Text="YOUR COMPUTERS" Style="{StaticResource Sec}" Margin="0"/>
                        <Button x:Name="RefreshBtn" Style="{StaticResource Btn}" Content="⟳" Padding="8,2"
                                Margin="10,0,0,0" Click="RefreshBtn_Click"/>
                        <TextBlock x:Name="ListMsg" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <ListView x:Name="CompList" Grid.Row="3" Background="#010409" Foreground="#e6edf3" BorderBrush="#30363d"
                              SelectionMode="Single" MouseDoubleClick="CompList_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Status" Width="110" DisplayMemberBinding="{Binding StatusText}"/>
                                <GridViewColumn Header="Computer" Width="260" DisplayMemberBinding="{Binding Display}"/>
                            </GridView>
                        </ListView.View>
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Foreground="#58a6ff" FontWeight="Bold" Margin="0,10,0,4"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

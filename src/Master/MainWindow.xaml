<Window x:Class="RemoteDesktop.Master.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Hangar" Height="700" Width="1020"
        WindowStartupLocation="CenterScreen" Background="#0A0D18">
    <!-- The entire hub UI is the Hangar design (Appendix C) rendered in WebView2;
         the in-session remote view opens in a separate native ViewerWindow. -->
    <wv2:WebView2 x:Name="Web"/>
</Window>

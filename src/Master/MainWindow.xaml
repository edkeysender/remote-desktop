<Window x:Class="RemoteDesktop.Master.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FTD Remote — Master (control a PC)" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen" Background="#010409">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <Border Grid.Row="0" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/logo-ftd.png" Height="22" Margin="0,0,16,0"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Server" Foreground="#8b949e" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="ServerBox" Width="200" Background="#0d1117" Foreground="#e6edf3"
                         BorderBrush="#30363d" Padding="6,4" VerticalContentAlignment="Center"/>
                <TextBlock Text="ID" Foreground="#8b949e" VerticalAlignment="Center" Margin="14,0,6,0"/>
                <TextBox x:Name="IdBox" Width="130" Background="#0d1117" Foreground="#e6edf3"
                         BorderBrush="#30363d" Padding="6,4" FontFamily="Consolas" VerticalContentAlignment="Center"/>
                <TextBlock Text="Password" Foreground="#8b949e" VerticalAlignment="Center" Margin="14,0,6,0"/>
                <TextBox x:Name="PwBox" Width="120" Background="#0d1117" Foreground="#e6edf3"
                         BorderBrush="#30363d" Padding="6,4" FontFamily="Consolas" VerticalContentAlignment="Center"/>
                <Button x:Name="ConnectBtn" Content="Connect" Width="110" Height="30" Margin="14,0,0,0"
                        Background="#238636" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Click="ConnectBtn_Click"/>
                <TextBlock Text="Monitor" Foreground="#8b949e" VerticalAlignment="Center" Margin="14,0,6,0"/>
                <ComboBox x:Name="MonitorSelector" Width="150" IsEnabled="False"
                          VerticalAlignment="Center" SelectionChanged="MonitorSelector_SelectionChanged"/>
                <TextBlock x:Name="StatusText" Text="idle" Foreground="#8b949e"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- remote screen -->
        <Grid Grid.Row="1">
            <TextBlock x:Name="Hint" Foreground="#6e7681" FontSize="14" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <Run Text="Enter the client's ID and password, then Connect."/>
                <LineBreak/>
                <Run Text="The remote screen appears here and your mouse + keyboard control it."/>
            </TextBlock>
            <Image x:Name="RemoteImage" Stretch="Uniform" Focusable="True"
                   Visibility="Collapsed"
                   MouseMove="RemoteImage_MouseMove"
                   MouseDown="RemoteImage_MouseDown"
                   MouseUp="RemoteImage_MouseUp"
                   MouseWheel="RemoteImage_MouseWheel"/>
        </Grid>
    </Grid>
</Window>

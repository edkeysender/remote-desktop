<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RemoteDesktop.Master</RootNamespace>
    <AssemblyName>FtdRemote</AssemblyName>
    <ApplicationIcon>..\..\assets\hangar.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.3.0</Version>
    <Product>FTD Remote</Product>
    <Company>FTD.aero</Company>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
    <!-- Host engine (HostSession, ScreenCapture, InputInjector) is reused from the
         Client project so the unified app can both host and view. -->
    <ProjectReference Include="..\Client\Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="SIPSorcery" Version="10.0.13" />
    <PackageReference Include="SIPSorceryMedia.Encoders" Version="10.0.4" />
    <PackageReference Include="SIPSorceryMedia.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\logo-ftd.png">
      <Link>logo-ftd.png</Link>
    </Resource>
    <!-- The Hangar desktop UI (Appendix C), rendered pixel-exact in WebView2. -->
    <EmbeddedResource Include="ui\desktop.html" />
  </ItemGroup>

</Project>

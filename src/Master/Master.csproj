<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RemoteDesktop.Master</RootNamespace>
    <AssemblyName>RemoteControl</AssemblyName>
    <ApplicationIcon>..\..\assets\remotler.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.3.0</Version>
    <Product>Remotler</Product>
    <Company>remotler.com</Company>
    <!-- This is a WPF app; DPI awareness comes from app.manifest. UseWindowsForms (tray icon
         only) triggers the WinForms high-DPI analyzer (WFAC010) — not applicable here. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <!-- UseWindowsForms is only for the tray NotifyIcon; drop its implicit global usings so
       WPF types (Clipboard, Application, MessageBox, …) don't become ambiguous. Tray code
       uses fully-qualified System.Windows.Forms.* / System.Drawing.* names. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
    <!-- Host engine (HostSession, ScreenCapture, InputInjector) is reused from the
         Client project so the unified app can both host and view. -->
    <ProjectReference Include="..\Client\Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="SIPSorcery" Version="10.0.13" />
    <PackageReference Include="SIPSorceryMedia.Encoders" Version="10.0.4" />
    <PackageReference Include="SIPSorceryMedia.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Remotler desktop UI (Appendix C), rendered pixel-exact in WebView2. -->
    <EmbeddedResource Include="ui\desktop.html" />
  </ItemGroup>

</Project>

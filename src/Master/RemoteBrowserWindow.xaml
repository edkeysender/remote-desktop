<Window x:Class="RemoteDesktop.Master.RemoteBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote files" Height="560" Width="760"
        WindowStartupLocation="CenterOwner" Background="#0d1117">
    <Window.Resources>
        <Style x:Key="Tool" TargetType="Button">
            <Setter Property="Background" Value="#21262d"/>
            <Setter Property="Foreground" Value="#e6edf3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="UpBtn" Content="↑ Up" Style="{StaticResource Tool}" Click="UpBtn_Click"/>
            <Button x:Name="RefreshBtn" Content="⟳ Refresh" Style="{StaticResource Tool}" Click="RefreshBtn_Click"/>
            <Button x:Name="DownloadBtn" Content="⬇ Download" Style="{StaticResource Tool}" Click="DownloadBtn_Click"/>
            <Button x:Name="UploadBtn" Content="⬆ Upload to this folder…" Style="{StaticResource Tool}" Click="UploadBtn_Click"/>
        </StackPanel>

        <!-- current path -->
        <Border Grid.Row="1" Background="#161b22" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
            <TextBlock x:Name="PathText" Text="This PC" Foreground="#8b949e" FontFamily="Consolas"
                       TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- listing -->
        <ListView x:Name="List" Grid.Row="2" Background="#010409" Foreground="#e6edf3"
                  BorderBrush="#30363d" MouseDoubleClick="List_MouseDoubleClick"
                  SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="560" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Size" Width="140" DisplayMemberBinding="{Binding SizeText}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock x:Name="StatusText" Grid.Row="3" Text="Connecting…" Foreground="#8b949e"
                   Margin="2,8,0,0" TextTrimming="CharacterEllipsis"/>
    </Grid>
</Window>

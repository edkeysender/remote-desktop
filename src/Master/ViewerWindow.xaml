<Window x:Class="RemoteDesktop.Master.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FTD Remote — session" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen" Background="#010409">
    <Window.Resources>
        <Style x:Key="MonBtn" TargetType="Button">
            <Setter Property="Background" Value="#0d1117"/>
            <Setter Property="BorderBrush" Value="#30363d"/>
            <Setter Property="Foreground" Value="#8b949e"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel>
                            <Border x:Name="Screen" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1.5" CornerRadius="3" Width="38" Height="24">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Background="{TemplateBinding BorderBrush}" Width="12" Height="2"
                                    CornerRadius="1" Margin="0,1,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Screen" Property="BorderBrush" Value="#58a6ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="#21262d"/>
            <Setter Property="Foreground" Value="#e6edf3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TitleText" Text="Connecting…" Foreground="#e6edf3" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>

                <StackPanel x:Name="MonitorPanel" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"/>

                <TextBlock Text="Zoom" Foreground="#8b949e" VerticalAlignment="Center" Margin="14,0,6,0"/>
                <ComboBox x:Name="ZoomBox" Width="74" IsEnabled="False" VerticalAlignment="Center"
                          SelectionChanged="ZoomBox_SelectionChanged">
                    <ComboBoxItem Content="Fit" Tag="0" IsSelected="True"/>
                    <ComboBoxItem Content="50 %" Tag="0.5"/>
                    <ComboBoxItem Content="100 %" Tag="1"/>
                    <ComboBoxItem Content="150 %" Tag="1.5"/>
                    <ComboBoxItem Content="200 %" Tag="2"/>
                </ComboBox>

                <Button x:Name="WinKeyBtn" Content="⊞ Win" Style="{StaticResource ToolBtn}"
                        Margin="14,0,0,0" IsEnabled="False" Click="WinKeyBtn_Click"
                        ToolTip="Send the Windows (Start) key to the remote PC"/>
                <Button x:Name="TransferBtn" Content="📁 Transfer files" Style="{StaticResource ToolBtn}"
                        Margin="6,0,0,0" IsEnabled="False" Click="TransferBtn_Click"
                        ToolTip="Browse the remote PC's files — download or upload"/>
                <Button x:Name="DisconnectBtn" Content="Disconnect" Margin="14,0,0,0"
                        Background="#da3633" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Height="30" Padding="12,0" Click="DisconnectBtn_Click"/>

                <TextBlock x:Name="StatusText" Text="" Foreground="#8b949e"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <TextBlock x:Name="Hint" Foreground="#6e7681" FontSize="14" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="Connecting to the remote computer…"/>
            <ScrollViewer x:Name="Scroller" Visibility="Collapsed" Background="#010409"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                          Focusable="False" PreviewMouseWheel="Scroller_PreviewMouseWheel"
                          MouseLeave="Scroller_MouseLeave"
                          AllowDrop="True" DragOver="RemoteView_DragOver" Drop="RemoteView_Drop"
                          DragLeave="RemoteView_DragLeave">
                <Image x:Name="RemoteImage" Stretch="Uniform" Focusable="True" AllowDrop="True"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       MouseMove="RemoteImage_MouseMove"
                       MouseDown="RemoteImage_MouseDown"
                       MouseUp="RemoteImage_MouseUp"/>
            </ScrollViewer>

            <Border x:Name="DropHint" Visibility="Collapsed" IsHitTestVisible="False"
                    Background="#cc010409" BorderBrush="#58a6ff" BorderThickness="2"
                    Margin="24" CornerRadius="12">
                <TextBlock Text="⬇  Drop files to send them to the remote PC" Foreground="#58a6ff"
                           FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</Window>
